# Split por categoria (nível 2) — mesmo conteúdo gerado, mesma regra
terraform/environments/*/*/main.tf
terraform/environments/*/*/imports_generated.tf
terraform/environments/*/*/.terraform/
terraform/environments/*/*/.terraform.lock.hcl
terraform/environments/*/*/terraform.tfstate*

# Generated migration snapshots and reports
terraform/**/lambda_code/
terraform/**/modularization_report.json

# tf-importer account output is private by default.
# Publication is always an explicit user decision (`git add -f <path>`).
/terraform/
/docs/inventory/
